{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AWS": {
    "Region": "eu-west-1",
    "SNS": {
      "WithdrawalTopicArn": "arn:aws:sns:eu-west-1:123456789012:withdrawals"
    }
  },
  "Outbox": {
    "BatchSize": 5,
    "MaximumAttempts": 5,
    "LeaseDurationMinutes": 5,
    "LeaseSafetyBufferSeconds": 30,
    "PollingIntervalSeconds": 2,
    "RetentionDays": 30,
    "DeadLetterRetentionDays": 90,
    "PublishTimeoutSeconds": 30
  },
  "ConnectionStrings": {
    "BankingDatabase": "Server=localhost;Database=Bank;Trusted_Connection=True;TrustServerCertificate=True"
  }
}
